#!/usr/bin/env bash

# Load environment variables for the case of execution from the Gradle build if they exist.
BASH_PROFILE=~/.bash_profile
BASH_RC=~/.bashrc

if [ -f ${BASH_PROFILE} ]; then
  echo "Using user's local bash profile."
  . ${BASH_PROFILE}
elif [ -f ${BASH_RC} ]; then
  echo "Using user's local bash runtime configuration."
  . ${BASH_RC}
fi

# Ensure `docs/_examples` files are fetched.
git submodule update --remote --merge --recursive

# Navigate to the folder with embed-code binaries.
cd _bin

# Use the macOS binary matching the host architecture.
if [ "$(uname -m)" = "arm64" ]; then
  TOOL="./embed-code-macos"
else
  TOOL="./embed-code-macos-x86_64"
fi

# Update code samples.
"$TOOL" -config-path="../_settings/embed-code.yml" -mode="embed"
